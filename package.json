{
  "name": "@dskripchenko/syntax",
  "version": "0.3.3",
  "description": "Syntax highlighting with zero runtime dependencies: 17 programming languages (JavaScript, TypeScript, Python, Go, Rust, Java, Kotlin, C#, Swift, C, C++, PHP, Ruby, Lua, Shell, PowerShell, SQL) and data formats, markup and the files around code (JSON, YAML, XML, HTML, CSS, TOML, INI, .env, CSV, Markdown, diff, logs, Dockerfile, Makefile, GraphQL, Protocol Buffers, HTTP)",
  "keywords": [
    "syntax-highlighting",
    "highlight",
    "highlighter",
    "tokenizer",
    "lexer",
    "code",
    "json",
    "yaml",
    "xml",
    "log",
    "markdown",
    "zero-dependency",
    "ssr"
  ],
  "homepage": "https://github.com/dskripchenko/syntax#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskripchenko/syntax.git"
  },
  "bugs": {
    "url": "https://github.com/dskripchenko/syntax/issues"
  },
  "license": "MIT",
  "author": "Denis Skripchenko (https://github.com/dskripchenko)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "corpus": "node scripts/corpus.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
